# VAPID keys for Web Push — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your@email.com

# Same public key, exposed to the frontend build (Vite requires the VITE_ prefix)
VITE_VAPID_PUBLIC_KEY=

# From an Upstash QStash project (console.upstash.com)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# The deployed site's URL (no trailing slash), e.g. https://ferro-corsa.vercel.app
# QStash needs this to be publicly reachable, so it only works once deployed.
PUBLIC_BASE_URL=
